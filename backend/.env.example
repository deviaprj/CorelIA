# Backend FastAPI — variables d'environnement
# Copier en .env et remplir les valeurs

# === IA ===
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxx
OLLAMA_CLOUD_URL=https://ollama.corelia.app
OLLAMA_CLOUD_API_KEY=ollama_cloud_key_xxx

# === Recherche Web ===
SERPAPI_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Voix (Ollama local uniquement — aucun service payant) ===
# Modèles Ollama pour STT et TTS (personnalisables si vous avez créé des Modelfiles)
OLLAMA_STT_MODEL=whisper
OLLAMA_TTS_MODEL=piper

# === Firebase ===
FIREBASE_PROJECT_ID=corelia-prod

# === Rate Limiting ===
REDIS_URL=redis://localhost:6379/0

# === App ===
APP_ENV=development
LOG_LEVEL=INFO
