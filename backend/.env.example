# Backend FastAPI — variables d'environnement
# Copier en .env et remplir les valeurs

# === IA ===
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxx
OLLAMA_CLOUD_URL=https://ollama.aironbot.app
OLLAMA_CLOUD_API_KEY=ollama_cloud_key_xxx

# === Recherche Web ===
SERPAPI_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Voix Pro ===
OPENAI_API_KEY=sk-openai-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Firebase ===
FIREBASE_PROJECT_ID=aironbot-prod

# === Rate Limiting ===
REDIS_URL=redis://localhost:6379/0

# === App ===
APP_ENV=development
LOG_LEVEL=INFO
