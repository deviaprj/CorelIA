// Runner.rc — Corely Windows resources
#include "resource.h"

IDI_APP_ICON ICON "resources/app_icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,1
 PRODUCTVERSION 1,0,0,1
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40000L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "CorelIA"
            VALUE "FileDescription", "Corely - AI Desktop Assistant"
            VALUE "FileVersion", "1.0.0.1"
            VALUE "InternalName", "corely"
            VALUE "LegalCopyright", "Copyright (C) 2026 CorelIA"
            VALUE "OriginalFilename", "corely.exe"
            VALUE "ProductName", "Corely"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
