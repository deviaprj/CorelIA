# ─────────────────────────────────────────────────────────
# Corely — Variables d'environnement (.env)
# Copier ce fichier en .env (racine du projet Flutter)
# et remplir les valeurs réelles.
# NE JAMAIS COMMITTER .env — il est déjà dans .gitignore
# ─────────────────────────────────────────────────────────

# ═══════════════════════════════════════════════════════════
# 1. INTELLIGENCE ARTIFICIELLE (IA)
# ═══════════════════════════════════════════════════════════

# DeepSeek API — modèle par défaut (gratuit)
# Obtenir sur : https://platform.deepseek.com
# Format      : sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter API — modèles premium + TTS vocal
# Obtenir sur : https://openrouter.ai
# Format      : sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxx

# ═══════════════════════════════════════════════════════════
# 2. RECHERCHE WEB & METEO
# ═══════════════════════════════════════════════════════════

# SerpAPI — recherche enrichie (Google Shopping, Hotels, Flights...)
# Obtenir sur : https://serpapi.com
# Format      : hash alphanumérique de 64 caractères
SERPAPI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenWeatherMap — prévisions météo
# Obtenir sur : https://openweathermap.org
# Format      : 32 caractères hexadécimaux
OPENWEATHERMAP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ═══════════════════════════════════════════════════════════
# 3. MONETISATION MOBILE (Google AdMob)
# ═══════════════════════════════════════════════════════════

# --- App IDs ---
# Android : ca-app-pub-XXXXXX~XXXXXXXX
# iOS     : ca-app-pub-XXXXXX~XXXXXXXX
ADMOB_APP_ID_ANDROID=ca-app-pub-XXXXXX~XXXXXXXX
ADMOB_APP_ID_IOS=ca-app-pub-XXXXXX~XXXXXXXX

# --- Banner (bannière) ---
ADMOB_BANNER_ID_ANDROID=ca-app-pub-XXXXXX/XXXXXXXXXX
ADMOB_BANNER_ID_IOS=ca-app-pub-XXXXXX/XXXXXXXXXX

# --- Interstitial (pleine page) ---
ADMOB_INTERSTITIAL_ID_ANDROID=ca-app-pub-XXXXXX/XXXXXXXXXX
ADMOB_INTERSTITIAL_ID_IOS=ca-app-pub-XXXXXX/XXXXXXXXXX

# --- Rewarded (vidéo récompensée) ---
ADMOB_REWARDED_ID_ANDROID=ca-app-pub-XXXXXX/XXXXXXXXXX
ADMOB_REWARDED_ID_IOS=ca-app-pub-XXXXXX/XXXXXXXXXX

# ═══════════════════════════════════════════════════════════
# 4. ABONNEMENTS PREMIUM (RevenueCat)
# ═══════════════════════════════════════════════════════════

# Android : commence par goog_
# iOS     : commence par appl_
REVENUECAT_API_KEY_ANDROID=goog_xxxxxxxxxxxxxxxxxxxx
REVENUECAT_API_KEY_IOS=appl_xxxxxxxxxxxxxxxxxxxx

# ═══════════════════════════════════════════════════════════
# 5. PAIEMENTS WEB / EXTENSION CHROME (Stripe)
# ═══════════════════════════════════════════════════════════

# Clé publique uniquement (côté client Flutter)
# Obtenir sur : https://dashboard.stripe.com/apikeys
# Format      : pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ═══════════════════════════════════════════════════════════
# 6. BACKEND CLOUD (Optionnel)
# ═══════════════════════════════════════════════════════════

# URL du backend FastAPI (ex: https://api.zentic.fr)
# Laisser vide si pas de backend — l'app fonctionne hors-ligne
BACKEND_URL=https://api.zentic.fr

# ═══════════════════════════════════════════════════════════
# 7. ENVIRONNEMENT
# ═══════════════════════════════════════════════════════════

# development | staging | production
APP_ENV=development
