# Copier ce fichier en .env (facultatif) et remplir les valeurs.
# Ne JAMAIS committer .env.
#
# Les clés sont injectées dans le binaire via --dart-define :
#   flutter build apk --dart-define=DEEPSEEK_API_KEY=sk-...
# Le fichier .env n'est PAS embarqué dans l'APK.

# === IA ===
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxx

# === Abonnement Agent IA Full (RevenueCat) ===
REVENUECAT_API_KEY_ANDROID=goog_xxxxxxxxxxxxxxxxxxxx
REVENUECAT_API_KEY_IOS=appl_xxxxxxxxxxxxxxxxxxxx

# === Mode démo (sans Firebase ni paiement) ===
# Activer via --dart-define=DEMO_MODE=true
