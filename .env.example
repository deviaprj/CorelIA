# Copier ce fichier en .env (facultatif) et remplir les valeurs.
# Ne JAMAIS committer .env.
#
# Les valeurs sont injectées dans le binaire via --dart-define :
#   flutter build apk --dart-define=CLOUDFLARE_WORKER_URL=https://api.zentic.fr
# Le fichier .env n'est PAS embarqué dans l'APK.

# === Cloudflare (passerelle IA) ===
# URL de base du Worker qui route les requêtes IA (domaine zentic.fr, DNS Cloudflare).
# Endpoint de chat appelé par l'app : $CLOUDFLARE_WORKER_URL/chat
CLOUDFLARE_WORKER_URL=https://api.zentic.fr

# Clé publique (soft gate) envoyée en en-tête X-API-Key.
# Générer : openssl rand -hex 32
CLIENT_API_KEY=

# === Fallback IA direct (développement uniquement) ===
# Non utilisé quand CLOUDFLARE_WORKER_URL est défini.
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Abonnement Agent IA Full (RevenueCat) ===
REVENUECAT_API_KEY_ANDROID=goog_xxxxxxxxxxxxxxxxxxxx
REVENUECAT_API_KEY_IOS=appl_xxxxxxxxxxxxxxxxxxxx

# === Mode démo (sans Firebase ni paiement) ===
# Activer via --dart-define=DEMO_MODE=true
