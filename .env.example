# Copier ce fichier en .env et remplir les valeurs
# Ne JAMAIS committer .env

# === IA (stockées en secrets Cloudflare Worker en production) ===
# En production, ces clés sont gérées côté Worker (wrangler secret put).
# Le client Flutter les utilise uniquement en fallback (développement local).
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxx

# === Backend (production) ===
# URL du backend cloud (api.zentic.fr). Injectée dans l'APK via --dart-define
# (le fichier .env n'est PAS embarqué dans l'APK — voir pubspec.yaml + ADR-027).
BACKEND_URL=https://api.zentic.fr

# CLIENT_API_KEY — clé douce (soft gate), embarquée dans l'APK via --dart-define.
# Extractable par conception (même classe de risque que DEEPSEEK_API_KEY). Gates
# les routes APK-facing (/scrape, /search_smart, /download_media, /crawl,
# /script/scrape, /script/api-fetch). Backend transition-open si vide.
# Générer : openssl rand -hex 32
CLIENT_API_KEY=

# API_SECRET_KEY — clé OPÉRATEUR (fail-closed). NE JAMAIS l'embarquer dans
# l'APK/extension ni la mettre dans ce fichier client. Elle vit UNIQUEMENT dans
# le .env du VPS (server_init.sh la génère). Gates /script/exec, /config/*,
# /agent/*, /insights/audit. Vide = 403 (défaut sûr).

# === AdMob ===
# En dev, utiliser les IDs de test :
# Banner Android  : ca-app-pub-3940256099942544/6300978111
# Rewarded Android: ca-app-pub-3940256099942544/5224354917
# Banner iOS      : ca-app-pub-3940256099942544/2934735716
# Rewarded iOS    : ca-app-pub-3940256099942544/1712485313
ADMOB_APP_ID_ANDROID=ca-app-pub-XXXXXX~XXXXXXXX
ADMOB_APP_ID_IOS=ca-app-pub-XXXXXX~XXXXXXXX
ADMOB_BANNER_ID_ANDROID=ca-app-pub-XXXXXX/XXXXXXXXXX
ADMOB_BANNER_ID_IOS=ca-app-pub-XXXXXX/XXXXXXXXXX
ADMOB_INTERSTITIAL_ID_ANDROID=ca-app-pub-XXXXXX/XXXXXXXXXX
ADMOB_INTERSTITIAL_ID_IOS=ca-app-pub-XXXXXX/XXXXXXXXXX
ADMOB_REWARDED_ID_ANDROID=ca-app-pub-XXXXXX/XXXXXXXXXX
ADMOB_REWARDED_ID_IOS=ca-app-pub-XXXXXX/XXXXXXXXXX

# === RevenueCat ===
REVENUECAT_API_KEY_ANDROID=goog_xxxxxxxxxxxxxxxxxxxx
REVENUECAT_API_KEY_IOS=appl_xxxxxxxxxxxxxxxxxxxx

# === Stripe (Web/Extension) ===
STRIPE_PUBLIC_KEY=pk_live_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
# URLs de checkout Stripe (publiques, embarquées côté client via --dart-define).
# En dev : URLs de test Stripe ; en prod : URLs de checkout live.
STRIPE_CHECKOUT_MONTHLY_URL=https://buy.stripe.com/test_corely_monthly
STRIPE_CHECKOUT_YEARLY_URL=https://buy.stripe.com/test_corely_yearly

# === Search APIs (optionnel — fallback enrichi recherche vols/météo/produits) ===
SERPAPI_API_KEY=
OPENWEATHERMAP_API_KEY=

# === Environnement ===
APP_ENV=development
