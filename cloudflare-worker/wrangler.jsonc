{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "corelia-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },

  // Route Worker sur la zone zentic.fr (déjà sur Cloudflare).
  // `api.zentic.fr` est couvert par un enregistrement de la zone : la route
  // rattache le Worker au hostname sans avoir à créer d'enregistrement DNS.
  // La zone héberge déjà d'autres routes (nei.zentic.fr) — elles sont conservées.
  "routes": [
    {
      "pattern": "api.zentic.fr/*",
      "zone_name": "zentic.fr"
    }
  ],

  // Workers AI (repli / vision) — aucune clé requise, facturé au neurone.
  "ai": {
    "binding": "AI"
  },

  "vars": {
    "ALLOWED_ORIGINS": "https://zentic.fr,https://www.zentic.fr",
    "AI_TEXT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "AI_VISION_MODEL": "@cf/meta/llama-3.2-11b-vision-instruct",
    "RATE_LIMIT_PER_MINUTE": "100"
  }

  // Secrets à définir (jamais dans ce fichier) :
  //   npx wrangler secret put DEEPSEEK_API_KEY   # clé du fournisseur IA
  //   npx wrangler secret put CLIENT_API_KEY     # clé publique de l'app (soft gate)
}
