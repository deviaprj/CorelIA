{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "corely-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },

  // Proxy transparent vers le backend Hetzner
  // Rate limiting géré par Cloudflare WAF (dashboard → Security → WAF)

  "vars": {
    "ENVIRONMENT": "production",
    "BACKEND_HOST": "167.233.100.132:80",
    "CORS_ORIGINS": "chrome-extension://*,https://zentic.fr,http://localhost:*"
  }

  // Secrets à définir via `npx wrangler secret put <NAME>` :
  //   API_SECRET_KEY     — Shared secret for Flutter client auth (optionnel, géré par le backend)
}
