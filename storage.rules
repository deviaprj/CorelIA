rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Fichiers uploadés par un utilisateur dans son propre folder
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 20 * 1024 * 1024; // Max 20 Mo
    }
  }
}
