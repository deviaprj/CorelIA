#!/usr/bin/env bash
# ============================================================================
# CorelIA Dev Environment — CLI de développement centralisé
# ============================================================================
# Usage :  ./corelia-dev          → Menu interactif
#          ./corelia-dev ssh      → SSH direct vers VPS
#          ./corelia-dev logs     → Logs backend
#          ./corelia-dev status   → Status rapide
#          ./corelia-vps          → Alias symlink
# ============================================================================

set -euo pipefail

VERSION="2.1.0"
VPS_HOST="167.233.100.132"
VPS_USER="corelia"
CORELIA_DIR="/home/geekai/Documents/GitHub/CorelIA"
NEIGLOO_DIR="/home/geekai/claude-workspace/neigloo"
WORKSPACE_DIR="/home/geekai/claude-workspace"
VPS_REMOTE_DIR="/opt/corelia"

# ── Couleurs ─────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
NC='\033[0m'
BOLD='\033[1m'
DIM='\033[2m'

# ── Header ──────────────────────────────────────────────────────────────

header() {
    clear
    echo -e "${PURPLE}"
    echo '   ╔═══════════════════════════════════════════════════╗'
    echo '   ║        CorelIA Dev Environment v'$VERSION'          ║'
    echo '   ║     🚀  VPS + Docker + Réseau + Workspaces       ║'
    echo '   ╚═══════════════════════════════════════════════════╝'
    echo -e "${NC}"
}

# ── SSH Key Detection ──────────────────────────────────────────────────

find_ssh_key() {
    local keys=(
        "$HOME/.ssh/id_ed25519_hetzner"
        "$HOME/.ssh/id_ed25519"
        "$HOME/.ssh/id_rsa"
        "$HOME/.ssh/id_ecdsa"
    )
    for k in "${keys[@]}"; do
        if [ -f "$k" ]; then
            echo "$k"
            return 0
        fi
    done
    # Vérifier si l'agent SSH a déjà une clé chargée
    if ssh-add -l &>/dev/null; then
        echo "__agent__"
        return 0
    fi
    echo ""
    return 1
}

SSH_KEY=$(find_ssh_key)
SSH_CMD="ssh -o StrictHostKeyChecking=no -o ConnectTimeout=10"
[ -n "$SSH_KEY" ] && [ "$SSH_KEY" != "__agent__" ] && SSH_CMD="$SSH_CMD -i $SSH_KEY"

vps() {
    $SSH_CMD "$VPS_USER@$VPS_HOST" "$@"
}

# ── Menu Principal ─────────────────────────────────────────────────────

main_menu() {
    header
    echo -e "  ${CYAN}${BOLD}SSH Key${NC} : $(ssh_key_status)"
    echo -e "  ${CYAN}${BOLD}VPS${NC}     : $VPS_HOST ($(vps_status))"
    echo -e "  ${CYAN}${BOLD}CWD${NC}     : $(pwd)"
    echo
    echo -e "  ${YELLOW}┌──────────────────────────────────────────────┐${NC}"
    echo -e "  ${YELLOW}│${NC}  ${BOLD}1${NC}  🚀  SSH → VPS                        ${YELLOW}│${NC}"
    echo -e "  ${YELLOW}│${NC}  ${BOLD}2${NC}  🐳  Docker : Status                  ${YELLOW}│${NC}"
    echo -e "  ${YELLOW}│${NC}  ${BOLD}3${NC}  📋  Docker : Logs                    ${YELLOW}│${NC}"
    echo -e "  ${YELLOW}│${NC}  ${BOLD}4${NC}  🔄  Docker : Restart                 ${YELLOW}│${NC}"
    echo -e "  ${YELLOW}│${NC}  ${BOLD}5${NC}  📦  Docker : Rebuild + Up            ${YELLOW}│${NC}"
    echo -e "  ${YELLOW}│${NC}  ${BOLD}6${NC}  🌐  Réseau : Diagnostics             ${YELLOW}│${NC}"
    echo -e "  ${YELLOW}│${NC}  ${BOLD}7${NC}  🔐  Sécurité : Vérification          ${YELLOW}│${NC}"
    echo -e "  ${YELLOW}│${NC}  ${BOLD}8${NC}  📁  Workspace : CorelIA              ${YELLOW}│${NC}"
    echo -e "  ${YELLOW}│${NC}  ${BOLD}9${NC}  🏪  Workspace : Neigloo              ${YELLOW}│${NC}"
    echo -e "  ${YELLOW}│${NC}  ${BOLD}10${NC} 📤  Sync : Local → VPS              ${YELLOW}│${NC}"
    echo -e "  ${YELLOW}│${NC}  ${BOLD}11${NC} 📥  Sync : VPS → Local              ${YELLOW}│${NC}"
    echo -e "  ${YELLOW}│${NC}  ${BOLD}12${NC} 🔧  Installer ce script dans PATH    ${YELLOW}│${NC}"
    echo -e "  ${YELLOW}│${NC}  ${BOLD}0${NC}   ❌  Quitter                        ${YELLOW}│${NC}"
    echo -e "  ${YELLOW}└──────────────────────────────────────────────┘${NC}"
    echo
    echo -ne "  ${GREEN}➜${NC} Choix : "
    read -r choice
    echo

    case "$choice" in
        1)  vps_shell ;;
        2)  docker_status ;;
        3)  docker_logs ;;
        4)  docker_restart ;;
        5)  docker_rebuild ;;
        6)  network_diag ;;
        7)  security_check ;;
        8)  cd_corelia ;;
        9)  cd_neigloo ;;
        10) sync_to_vps ;;
        11) sync_from_vps ;;
        12) install_script ;;
        0)  echo -e "  ${GREEN}👋 À bientôt !${NC}" ; exit 0 ;;
        *)  echo -e "  ${RED}❌ Choix invalide${NC}" ; sleep 1 ; main_menu ;;
    esac
}

# ── Utilitaires ────────────────────────────────────────────────────────

ssh_key_status() {
    if [ "$SSH_KEY" = "__agent__" ]; then
        echo -e "${GREEN}✓ Agent SSH actif${NC}"
    elif [ -n "$SSH_KEY" ]; then
        echo -e "${GREEN}✓ $(basename $SSH_KEY)${NC}"
    else
        echo -e "${RED}✗ Aucune clé trouvée${NC}"
    fi
}

vps_status() {
    if $SSH_CMD "$VPS_USER@$VPS_HOST" "echo OK" &>/dev/null; then
        echo -e "${GREEN}✓ Connecté${NC}"
    else
        echo -e "${RED}✗ Déconnecté${NC}"
    fi
}

pause() {
    echo
    echo -ne "  ${DIM}Appuie sur Entrée pour continuer...${NC}"
    read -r
}

# ── Actions ────────────────────────────────────────────────────────────

vps_shell() {
    echo -e "  ${BLUE}🔌 Connexion SSH au VPS...${NC}"
    echo -e "  ${DIM}Utilise 'exit' ou Ctrl+D pour revenir au menu.${NC}"
    echo
    $SSH_CMD -t "$VPS_USER@$VPS_HOST" "cd $VPS_REMOTE_DIR && exec \$SHELL -l"
    pause
    main_menu
}

docker_status() {
    header
    echo -e "  ${CYAN}${BOLD}🐳 Services Docker — VPS${NC}\n"
    vps "docker compose -f $VPS_REMOTE_DIR/docker-compose.yml ps --format 'table {{.Name}}\t{{.Status}}\t{{.Ports}}'" 2>&1 || echo -e "  ${RED}✗ Échec de connexion${NC}"
    echo
    echo -e "  ${CYAN}${BOLD}📊 Ressources VPS${NC}\n"
    vps "echo 'RAM:'; free -h | grep Mem; echo 'DISQUE:'; df -h / | tail -1; echo 'UPTIME:'; uptime -p" 2>&1
    pause
    main_menu
}

docker_logs() {
    header
    echo -e "  ${CYAN}${BOLD}📋 Logs disponibles${NC}\n"
    echo -e "  ${BOLD}1${NC}  Backend"
    echo -e "  ${BOLD}2${NC}  Caddy (proxy)"
    echo -e "  ${BOLD}3${NC}  Redis"
    echo -e "  ${BOLD}4${NC}  Ollama"
    echo -e "  ${BOLD}5${NC}  Agent"
    echo -e "  ${BOLD}6${NC}  Watchtower"
    echo -e "  ${BOLD}7${NC}  Tous les logs"
    echo -e "  ${BOLD}0${NC}  Retour"
    echo
    echo -ne "  ${GREEN}➜${NC} Service : "
    read -r svc
    local lines=30
    echo -ne "  ${GREEN}➜${NC} Lignes (défaut 30) : "
    read -r input
    [ -n "$input" ] && lines=$input

    case "$svc" in
        1) vps "docker logs corelia-backend --tail=$lines --follow" ;;
        2) vps "docker logs corelia-caddy --tail=$lines --follow" ;;
        3) vps "docker logs corelia-redis --tail=$lines" ;;
        4) vps "docker logs corelia-ollama --tail=$lines" ;;
        5) vps "docker logs corelia-codewhale-agent --tail=$lines" ;;
        6) vps "docker logs corelia-watchtower --tail=$lines" ;;
        7) vps "docker compose -f $VPS_REMOTE_DIR/docker-compose.yml logs --tail=$lines" ;;
        0) main_menu ;;
        *) echo -e "  ${RED}✗ Choix invalide${NC}" ; sleep 1 ; docker_logs ;;
    esac
    pause
    main_menu
}

docker_restart() {
    header
    echo -e "  ${YELLOW}⚠️  Redémarrage des services...${NC}\n"
    vps "docker compose -f $VPS_REMOTE_DIR/docker-compose.yml restart" 2>&1
    echo
    echo -e "  ${GREEN}✅ Redémarrage terminé${NC}"
    sleep 2
    docker_status
}

docker_rebuild() {
    header
    echo -e "  ${YELLOW}⚠️  Reconstruction et déploiement complet...${NC}\n"
    echo -e "  ${BOLD}1${NC}  Backend seulement"
    echo -e "  ${BOLD}2${NC}  CodeWhale Agent seulement"
    echo -e "  ${BOLD}3${NC}  Toute la stack"
    echo -e "  ${BOLD}0${NC}  Retour"
    echo
    echo -ne "  ${GREEN}➜${NC} Mode : "
    read -r mode

    case "$mode" in
        1) vps "cd $VPS_REMOTE_DIR && docker compose build backend && docker compose up -d --remove-orphans backend" 2>&1 ;;
        2) vps "cd $VPS_REMOTE_DIR && docker compose build codewhale-agent && docker compose up -d --remove-orphans codewhale-agent" 2>&1 ;;
        3) vps "cd $VPS_REMOTE_DIR && docker compose build && docker compose up -d --remove-orphans" 2>&1 ;;
        0) main_menu ;;
        *) echo -e "  ${RED}✗ Choix invalide${NC}"; sleep 1; docker_rebuild ;;
    esac
    echo
    echo -e "  ${GREEN}✅ Build terminé${NC}"
    sleep 2
    docker_status
}

network_diag() {
    header
    echo -e "  ${CYAN}${BOLD}🌐 Diagnostics réseau${NC}\n"

    # DNS
    echo -ne "  DNS api.zentic.fr : "
    if vps "host api.zentic.fr 2>/dev/null || nslookup api.zentic.fr 2>/dev/null | grep -oP 'Address: \K.*' || dig +short api.zentic.fr 2>/dev/null" 2>&1 | grep -qE '^[0-9]'; then
        echo -e "${GREEN}✓ Résout${NC}"
    else
        echo -e "${RED}✗ NXDOMAIN${NC}"
    fi

    # Ports ouverts
    echo -e "\n  ${BOLD}Ports ouverts (VPS) :${NC}"
    vps "ss -tlnp | grep -E ':(80|443|22|8000|8001|11434|6379|8080|300[01])' | sed 's/.*://'" 2>&1 | head -10

    # Connexion au backend
    echo
    echo -ne "  Backend (Caddy local) : "
    if vps "curl -s -o /dev/null -w '%{http_code}' http://localhost/health" 2>&1 | grep -q 200; then
        echo -e "${GREEN}✓ HTTP 200${NC}"
    else
        echo -e "${RED}✗ Échec${NC}"
    fi

    # Redis
    echo -ne "  Redis : "
    if vps "docker exec corelia-redis redis-cli ping 2>/dev/null" 2>&1 | grep -q PONG; then
        echo -e "${GREEN}✓ PONG${NC}"
    else
        echo -e "${RED}✗ Échec${NC}"
    fi

    # Ollama
    echo -ne "  Ollama : "
    if vps "curl -s -o /dev/null -w '%{http_code}' http://localhost:11434/api/tags" 2>&1 | grep -q 200; then
        echo -e "${GREEN}✓ OK${NC}"
    else
        echo -e "${RED}✗ Échec${NC}"
    fi

    # UFW
    echo -ne "  Pare-feu (UFW) : "
    local ufw_status
    ufw_status=$(vps "sudo ufw status 2>/dev/null | head -1" 2>&1)
    if echo "$ufw_status" | grep -qi "active"; then
        echo -e "${GREEN}✓ Actif${NC}"
    else
        echo -e "${RED}✗ Inactif${NC}"
    fi

    # Ping VPS
    echo -ne "  Ping VPS ($VPS_HOST) : "
    if ping -c1 -W2 "$VPS_HOST" &>/dev/null; then
        echo -e "${GREEN}✓ Répond${NC}"
    else
        echo -e "${RED}✗ Pas de réponse${NC}"
    fi

    pause
    main_menu
}

security_check() {
    header
    echo -e "  ${CYAN}${BOLD}🔐 Vérification sécurité${NC}\n"

    # fail2ban
    echo -ne "  fail2ban (SSH) : "
    local f2b
    f2b=$(vps "sudo fail2ban-client status sshd 2>/dev/null" 2>&1)
    if echo "$f2b" | grep -qi "Status"; then
        local banned
        banned=$(echo "$f2b" | grep "Banned IP list" | awk -F':' '{print $2}')
        echo -e "${GREEN}✓ Actif — Bannis:$banned${NC}"
    else
        echo -e "${RED}✗ Inactif / non installé${NC}"
    fi

    # Root login
    echo -ne "  Root login SSH : "
    if vps "sudo grep '^PermitRootLogin' /etc/ssh/sshd_config | grep -q 'no'" 2>&1; then
        echo -e "${GREEN}✓ Désactivé${NC}"
    else
        echo -e "${RED}✗ Possiblement activé${NC}"
    fi

    # Password auth
    echo -ne "  Password auth SSH : "
    if vps "sudo grep '^PasswordAuthentication' /etc/ssh/sshd_config | grep -q 'no'" 2>&1; then
        echo -e "${GREEN}✓ Désactivé (clé uniquement)${NC}"
    else
        echo -e "${RED}✗ Possiblement activé${NC}"
    fi

    # Tentatives SSH récentes
    echo -e "\n  ${BOLD}Tentatives SSH récentes :${NC}"
    vps "sudo tail -20 /var/log/auth.log 2>/dev/null | grep -E 'Failed|Invalid' | tail -5" 2>&1 || echo "  (aucune)"

    # Docker socket exposé ?
    echo -e "\n  ${BOLD}Protection Docker :${NC}"
    vps "sudo docker network ls &>/dev/null && echo '  ✓ Docker accessible uniquement par sudo/API'" 2>&1

    # Watchtower status
    echo -ne "\n  Watchtower : "
    local wt
    wt=$(vps "docker inspect corelia-watchtower --format='{{.State.Status}}' 2>/dev/null" 2>&1)
    if [ "$wt" = "running" ]; then
        echo -e "${GREEN}✓ Running${NC}"
    elif [ "$wt" = "restarting" ]; then
        echo -e "${RED}✗ Restarting loop${NC}"
    else
        echo -e "${YELLOW}⚠ $wt${NC}"
    fi

    pause
    main_menu
}

cd_corelia() {
    echo -e "  ${BLUE}📁 → CorelIA${NC}"
    cd "$CORELIA_DIR" || { echo -e "  ${RED}✗ Dossier introuvable${NC}"; sleep 1; main_menu; }
    pwd
    echo
    echo -e "  ${DIM}Tu es maintenant dans le dossier CorelIA.${NC}"
    echo -e "  ${DIM}Tape 'exit' pour revenir au menu.${NC}"
    echo
    $SHELL
    main_menu
}

cd_neigloo() {
    echo -e "  ${BLUE}📁 → Neigloo${NC}"
    cd "$NEIGLOO_DIR" || { echo -e "  ${RED}✗ Dossier introuvable${NC}"; sleep 1; main_menu; }
    pwd
    echo
    echo -e "  ${DIM}Tu es maintenant dans le dossier Neigloo.${NC}"
    echo -e "  ${DIM}Tape 'exit' pour revenir au menu.${NC}"
    echo
    $SHELL
    main_menu
}

sync_to_vps() {
    header
    echo -e "  ${YELLOW}📤 Synchronisation Local → VPS${NC}\n"
    echo -e "  ${BOLD}1${NC}  Configuration uniquement (Caddyfile, docker-compose, scripts)"
    echo -e "  ${BOLD}2${NC}  Backend complet (Python + configs)"
    echo -e "  ${BOLD}3${NC}  Tout le projet (sauf .env, node_modules, .dart_tool)"
    echo -e "  ${BOLD}0${NC}  Retour"
    echo
    echo -ne "  ${GREEN}➜${NC} Sync : "
    read -r sync_mode
    local rsync_opts="-avz --progress --delete -e '$SSH_CMD'"

    case "$sync_mode" in
        1)
            echo -e "  ${CYAN}Syncing configs...${NC}"
            # shellcheck disable=SC2086
            rsync -avz --progress $SSH_CMD \
                "$CORELIA_DIR/Caddyfile" \
                "$CORELIA_DIR/docker-compose.yml" \
                "$CORELIA_DIR/cloud-config.yaml" \
                "$CORELIA_DIR/scripts/" \
                "$VPS_USER@$VPS_HOST:$VPS_REMOTE_DIR/"
            echo
            echo -e "  ${GREEN}✅ Configs syncées. Redémarrage ? (o/N)${NC}"
            read -r restart
            if [[ "$restart" =~ ^[oO]$ ]]; then
                vps "cd $VPS_REMOTE_DIR && docker compose up -d --remove-orphans"
                echo -e "  ${GREEN}✅ Services redémarrés${NC}"
            fi
            ;;
        2)
            echo -e "  ${CYAN}Syncing backend...${NC}"
            # shellcheck disable=SC2086
            rsync -avz --progress $SSH_CMD \
                --exclude='.venv' --exclude='__pycache__' --exclude='*.pyc' \
                "$CORELIA_DIR/backend/" "$VPS_USER@$VPS_HOST:$VPS_REMOTE_DIR/backend/"
            echo
            echo -e "  ${GREEN}✅ Backend syncé. Rebuild ? (o/N)${NC}"
            read -r rebuild
            if [[ "$rebuild" =~ ^[oO]$ ]]; then
                vps "cd $VPS_REMOTE_DIR && docker compose build backend && docker compose up -d --remove-orphans backend"
                echo -e "  ${GREEN}✅ Backend rebuild + restart${NC}"
            fi
            ;;
        3)
            echo -e "  ${CYAN}Syncing projet complet...${NC}\n"
            echo -e "  ${YELLOW}⚠ Cela peut prendre quelques minutes${NC}"
            # shellcheck disable=SC2086
            rsync -avz --progress $SSH_CMD \
                --exclude='.git' --exclude='.env' \
                --exclude='__pycache__' --exclude='*.pyc' --exclude='.venv' \
                --exclude='node_modules' --exclude='.dart_tool' --exclude='build/' \
                --exclude='android/' --exclude='ios/' --exclude='linux/' \
                --exclude='.flutter-plugins*' \
                "$CORELIA_DIR/" "$VPS_USER@$VPS_HOST:$VPS_REMOTE_DIR/"
            echo
            echo -e "  ${GREEN}✅ Sync complète. Rebuild + restart ? (o/N)${NC}"
            read -r rebuild
            if [[ "$rebuild" =~ ^[oO]$ ]]; then
                vps "cd $VPS_REMOTE_DIR && docker compose build && docker compose up -d --remove-orphans"
                echo -e "  ${GREEN}✅ Stack rebuild + restart${NC}"
            fi
            ;;
        0) main_menu ;;
        *) echo -e "${RED}✗ Invalide${NC}"; sleep 1; sync_to_vps ;;
    esac
    pause
    main_menu
}

sync_from_vps() {
    header
    echo -e "  ${YELLOW}📥 Synchronisation VPS → Local${NC}\n"
    echo -e "  ${BOLD}1${NC}  Logs backend"
    echo -e "  ${BOLD}2${NC}  Toute la config VPS"
    echo -e "  ${BOLD}0${NC}  Retour"
    echo
    echo -ne "  ${GREEN}➜${NC} Sync : "
    read -r sync_mode

    case "$sync_mode" in
        1)
            local logfile="$CORELIA_DIR/backend_logs_$(date +%Y%m%d_%H%M).txt"
            vps "docker logs corelia-backend --tail=200" > "$logfile"
            echo -e "  ${GREEN}✅ Logs sauvegardés : $logfile${NC}"
            ;;
        2)
            rsync -avz $SSH_CMD "$VPS_USER@$VPS_HOST:$VPS_REMOTE_DIR/" "$CORELIA_DIR/vps_backup/"
            echo -e "  ${GREEN}✅ Config VPS sauvegardée dans vps_backup/${NC}"
            ;;
        0) main_menu ;;
        *) echo -e "${RED}✗ Invalide${NC}"; sleep 1; sync_from_vps ;;
    esac
    pause
    main_menu
}

install_script() {
    local target="/usr/local/bin/corelia-dev"
    echo -e "  ${CYAN}🔧 Installation dans PATH...${NC}"
    if [ -w "$(dirname "$target")" ]; then
        cp "$0" "$target"
        chmod +x "$target"
        # Alias
        ln -sf "$target" "/usr/local/bin/corelia-vps"
        ln -sf "$target" "/usr/local/bin/cvps"
        echo -e "  ${GREEN}✅ Installé :${NC}"
        echo -e "     corelia-dev  → $target"
        echo -e "     corelia-vps  → alias"
        echo -e "     cvps         → alias court"
    else
        echo -e "  ${YELLOW}⚠ Permission refusée pour $target${NC}"
        echo -e "  Essaie : sudo cp \"$0\" $target"
        echo -e "          sudo chmod +x $target"
    fi
    pause
    main_menu
}

# ── Mode Commande Directe ──────────────────────────────────────────────

if [ $# -gt 0 ]; then
    case "$1" in
        ssh|vps|connect)
            $SSH_CMD -t "$VPS_USER@$VPS_HOST" "cd $VPS_REMOTE_DIR && exec \$SHELL -l"
            ;;
        status|ps)
            vps "docker compose -f $VPS_REMOTE_DIR/docker-compose.yml ps"
            echo "---"
            vps "free -h | grep Mem; df -h / | tail -1; uptime -p"
            ;;
        logs)
            local lines="${2:-30}"
            vps "docker compose -f $VPS_REMOTE_DIR/docker-compose.yml logs --tail=$lines"
            ;;
        restart)
            vps "docker compose -f $VPS_REMOTE_DIR/docker-compose.yml restart"
            echo "✅ Services redémarrés"
            ;;
        rebuild)
            vps "cd $VPS_REMOTE_DIR && docker compose build && docker compose up -d --remove-orphans"
            echo "✅ Stack rebuild et déployée"
            ;;
        sync)
            rsync -avz --progress $SSH_CMD \
                --exclude='.git' --exclude='.env' --exclude='__pycache__' --exclude='*.pyc' \
                --exclude='.venv' --exclude='node_modules' --exclude='.dart_tool' --exclude='build/' \
                --exclude='android/' --exclude='ios/' --exclude='linux/' \
                "$CORELIA_DIR/" "$VPS_USER@$VPS_HOST:$VPS_REMOTE_DIR/"
            echo "✅ Sync terminée"
            ;;
        network|net|diag)
            echo "=== DNS ==="
            vps "host api.zentic.fr 2>&1 || echo 'NXDOMAIN'"
            echo "=== Ports ==="
            vps "ss -tlnp | grep -E ':(80|443|22|8000|8001|11434)'"
            echo "=== Services ==="
            vps "curl -s -o /dev/null -w 'Backend: %{http_code}\n' http://localhost/health"
            vps "docker exec corelia-redis redis-cli ping 2>/dev/null && echo 'Redis: OK' || echo 'Redis: FAIL'"
            ;;
        security|sec)
            echo "=== fail2ban ==="
            vps "sudo fail2ban-client status sshd 2>&1"
            echo "=== UFW ==="
            vps "sudo ufw status 2>&1"
            echo "=== Tentatives SSH ==="
            vps "sudo tail -10 /var/log/auth.log 2>/dev/null | grep -E 'Failed|Invalid' | tail -5"
            ;;
        help|--help|-h)
            echo "CorelIA Dev Environment v$VERSION"
            echo
            echo "Usage:"
            echo "  corelia-dev              → Menu interactif"
            echo "  corelia-dev ssh          → SSH vers le VPS"
            echo "  corelia-dev status       → Status des services"
            echo "  corelia-dev logs [N]     → N dernières lignes de logs"
            echo "  corelia-dev restart      → Redémarrer les services"
            echo "  corelia-dev rebuild      → Rebuild + déploiement complet"
            echo "  corelia-dev sync         → Sync local → VPS"
            echo "  corelia-dev network      → Diagnostics réseau"
            echo "  corelia-dev security     → Vérification sécurité"
            echo "  corelia-dev help         → Cette aide"
            ;;
        *)
            echo "❌ Commande inconnue : $1"
            echo "   Utilise 'corelia-dev help' pour la liste des commandes"
            exit 1
            ;;
    esac
else
    main_menu
fi